PLATFORM = hpux
#  The HP ANSI C compiler, which ships alongside aCC.  The bundled
#  /usr/bin/cc is K&R only and will not do; set CC = gcc where that is
#  installed instead.
CC = /opt/ansic/bin/cc
#  -Ae is HP cc's ANSI mode with the extensions the system headers want.
OPTFLAGS = -Ae +O2
#  X11R6 is off the default linker path and HP-UX ships no libXpm.
LDFLAGS += -L/usr/lib/X11R6
XPMLIB =
CPPFLAGS += -DNO_XPM
#  HP cc has no -MMD; its +M prints dependencies instead of compiling, so
#  the build simply does without them.
DEPFLAGS =
#  HP-UX has no BSD install(1); the wrapper gives the Makefile the -m it
#  expects.
INSTALL = sh hpux/install.sh
INSTALLDIR = mkdir -p
