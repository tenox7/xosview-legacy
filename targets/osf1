PLATFORM = osf1
#  Compaq/DEC C++ on 4.0 and later; use CXX=g++ where that is what is
#  installed.  -std strict_ansi is not used, the headers need the default.
CXX = cxx
OPTFLAGS = -O2
#  Tru64 ships no libXpm; only the pixmapName resource is lost.
LDFLAGS += -L/usr/shlib
#  cxx spells -MMD -MD, and it has no -Wno-write-strings.
DEPFLAGS = -MD
NOWRITESTRINGS =
