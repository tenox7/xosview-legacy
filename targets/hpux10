PLATFORM = hpux
CC = gcc
#  10.20 keeps X11R6 off the default compiler and linker paths and ships no
#  libXpm; only the pixmapName resource is lost with -DNO_XPM.
CPPFLAGS += -I/usr/include/X11R6 -I/usr/contrib/X11R6/include -DNO_XPM
LDFLAGS += -L/usr/lib/X11R6 -L/usr/contrib/X11R6/lib
XPMLIB =
#  Add -DNO_PSS_NBLKSENABLED here if pst_swapinfo turns out to lack that
#  field, as it does on 9.x.
#  HP-UX has no BSD install(1); the wrapper gives the Makefile the -m it
#  expects.
INSTALL = sh hpux/install.sh
INSTALLDIR = mkdir -p
