#!/bin/sh
#  Print the name of the file in targets/ that fits this system.  The Makefile
#  runs this when there is no .config and no TARGET= on the command line.

s=`uname -s`
r=`uname -r`
v=`uname -v`
t=

case "$s" in
  Linux)       t=linux ;;
  GNU)         t=gnu ;;
  OSF1)        t=osf1 ;;
  FreeBSD)     t=freebsd ;;
  NetBSD)      t=netbsd ;;
  OpenBSD)     t=openbsd ;;
  DragonFly)   t=dragonflybsd ;;
  IRIX|IRIX64) t=irix65 ;;
  #  Only OpenServer 6 is supported; uname -v is what separates it from 5.
  SCO_SV)      case "$v" in 6.*) t=osr6 ;; esac ;;
  UnixWare|UNIX_SV) t=unixware ;;
  SunOS)       case "$r" in 5.*) t=sunos5 ;; esac ;;
  #  libperfstat arrived in AIX 5.1 and is exactly what decides the back end,
  #  so test for it rather than picking apart uname.
  AIX)         if [ -f /usr/lib/libperfstat.a ]; then t=aix5; else t=aix4; fi ;;
  #  uname -r here is B.11.31, A.09.05 and so on.  targets/hpux11 builds with
  #  aCC, which only exists from 11.x on.
  HP-UX)       case "$r" in
                 *.09.*) t=hpux9 ;;
                 *.10.*) t=hpux10 ;;
                 *.11.*) t=hpux11 ;;
               esac ;;
esac

if [ -z "$t" ]; then
  echo "guess-target: $s $r is not known here, building for linux" >&2
  echo "guess-target: cp targets/<name> .config to pick another" >&2
  t=linux
fi

echo "=> targets/$t" >&2
echo "$t"
